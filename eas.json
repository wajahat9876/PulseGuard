{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
     "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
            "channel": "preview"
    },
    "sqa": {
      "channel": "sqa",
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
       "ios": {
        "autoIncrement": true,
        "image": "macos-sonoma-14.6-xcode-16.0"
      },
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
